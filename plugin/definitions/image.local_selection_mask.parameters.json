{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "inverted": {
      "type": "boolean"
    },
    "maskEncoding": {
      "const": "grayscale_white_selected_v1",
      "type": "string"
    },
    "sourceHeight": {
      "maximum": 8192,
      "minimum": 1,
      "type": "integer"
    },
    "sourceWidth": {
      "maximum": 8192,
      "minimum": 1,
      "type": "integer"
    },
    "strokeCount": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "inverted",
    "maskEncoding",
    "sourceHeight",
    "sourceWidth",
    "strokeCount"
  ],
  "title": "Local selection mask authoring parameters",
  "type": "object"
}
